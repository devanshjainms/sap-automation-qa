#
# Copy this file to deploy/.env and fill in values before running
# `./scripts/setup.sh container start`.
#
# Lines starting with # are comments.  Uncomment and set values as needed.
# Variables with defaults shown after ":-" are optional.

# ─── Logging ───────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO

# ─── Azure OpenAI (required for AI agent / chat) ──────────────────
# Without these the agent is disabled; the rest of the platform works.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─── Azure OpenAI Embeddings (optional — enables vector search) ───
# AZURE_OPENAI_EMBEDDING_ENDPOINT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_API_KEY=
# EMBEDDING_DIMENSIONS=768

# ─── Ollama fallback for embeddings (local, no Azure needed) ──────
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── MCP server ───────────────────────────────────────────────────
# MCP_PORT=8001
# MCP_HOST=0.0.0.0
# MCP_RATE_LIMIT_RPM=60
# MCP_AUTH_TOKEN=          # Set to require Bearer auth on MCP

# ─── Core API internal URL (used by MCP → STAF bridge) ───────────
# CORE_API_URL=http://sap-qa-service:8000

# ─── Scheduler ────────────────────────────────────────────────────
# SCHEDULER_CHECK_INTERVAL=60

# ─── CORS ─────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Telemetry — Azure Log Analytics ─────────────────────────────
# TELEMETRY_DATA_DESTINATION=
# LAWS_WORKSPACE_ID=
# LAWS_SHARED_KEY=
# LAWS_SUBSCRIPTION_ID=
# LAWS_RESOURCE_GROUP=
# LAWS_WORKSPACE_NAME=

# ─── Telemetry — Azure Data Explorer (Kusto) ─────────────────────
# ADX_DATABASE_NAME=
# ADX_CLUSTER_FQDN=
# ADX_CLIENT_ID=

# ─── Docker host UID/GID mapping ─────────────────────────────────
# HOST_UID=1000
# HOST_GID=1000
