#
# Copy this file to deploy/.env and fill in values before running
# `./scripts/setup.sh container start`.
#
# Lines starting with # are comments.  Uncomment and set values as needed.
# Variables with defaults shown after ":-" are optional.

# ─── Logging ───────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO

# ─── Azure AD Authentication (required) ───────────────────────────
# All API endpoints (except /healthz and /auth/config) require a valid
# Azure AD bearer token.  Register an App in Azure AD and set:
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Override the API scope returned to the frontend by /auth/config.
# Defaults to api://{AZURE_CLIENT_ID}/access_as_user when not set.
# Must match a scope exposed in your Azure AD app registration.
# AZURE_API_SCOPE=api://<client-id>/access_as_user
#
# For local development without Azure AD, set AUTH_DEV_MODE=true
# (blocked when LOG_FORMAT=json as a production safety guard).
# AUTH_DEV_MODE=false

# ─── MCP server ───────────────────────────────────────────────────
# MCP_PORT=8001
# MCP_HOST=0.0.0.0
# MCP_AUTH_MODE — controls MCP server authentication:
#   none     : No auth (default)
#   api_key  : Static API key (set MCP_API_KEY)
#   bearer   : Static bearer token (set MCP_BEARER_TOKEN)
# MCP_AUTH_MODE=none
# MCP_API_KEY=
# MCP_BEARER_TOKEN=

# ─── Storage — Azure Table (optional, uses SQLite when unset) ─────
# Uses DefaultAzureCredential (Managed Identity).
# AZURE_TABLE_ENDPOINT=https://<account>.table.core.windows.net
# AZURE_TABLE_JOBS=jobs
# AZURE_TABLE_SCHEDULES=schedules

# ─── Embedding model ──────────────────────────────────────────────
# HuggingFace model name for semantic search. Pre-downloaded at build time.
# EMBEDDING_MODEL=microsoft/harrier-oss-v1-270m

# ─── Core API internal URL (used by MCP → STAF bridge) ───────────
# CORE_API_URL=http://sap-qa-service:8000

# ─── Scheduler ────────────────────────────────────────────────────
# SCHEDULER_CHECK_INTERVAL=60

# ─── CORS ─────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Telemetry — Azure Log Analytics ─────────────────────────────
# TELEMETRY_DATA_DESTINATION=
# LAWS_WORKSPACE_ID=
# LAWS_SHARED_KEY=
# LAWS_SUBSCRIPTION_ID=
# LAWS_RESOURCE_GROUP=
# LAWS_WORKSPACE_NAME=

# ─── Telemetry — Azure Data Explorer (Kusto) ─────────────────────
# ADX_DATABASE_NAME=
# ADX_CLUSTER_FQDN=
# ADX_CLIENT_ID=

# ─── Docker host UID/GID mapping ─────────────────────────────────
# HOST_UID=1000
# HOST_GID=1000
